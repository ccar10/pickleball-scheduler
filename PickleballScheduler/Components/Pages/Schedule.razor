@page "/event/{EventId:int}/schedule"
@inject EventService EventService
@inject ScheduleGenerator ScheduleGenerator
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Schedule</PageTitle>

@if (evt == null)
{
    <p>Loading...</p>
}
else
{
    <div class="no-print mb-3">
        <a href="/event/@evt.Id/setup" class="btn btn-outline-secondary btn-sm me-2">Edit Setup</a>
        <a href="/event/@evt.Id/stats" class="btn btn-outline-secondary btn-sm me-2">View Stats</a>
        <button class="btn btn-outline-primary btn-sm me-2" @onclick="Print">Print Schedule</button>
        <button class="btn btn-sm me-2 @(editMode ? "btn-success" : "btn-outline-success")" @onclick="ToggleEditMode">
            @(editMode ? "Done Editing" : "Rearrange Players")
        </button>
        <button class="btn btn-outline-warning btn-sm me-2" @onclick="@(() => showRegenerateConfirm = true)" disabled="@isRegenerating">
            @(isRegenerating ? "Regenerating..." : "Regenerate")
        </button>
        <label class="me-2 small align-middle" style="cursor: pointer; user-select: none;">
            <input type="checkbox" class="form-check-input me-1" @bind="trackScores" /> Track scores
        </label>
        <label class="me-2 small align-middle" style="cursor: pointer; user-select: none;">
            <input type="checkbox" class="form-check-input me-1" @bind="showByeColumn" /> Show Bye column
        </label>
        @if (trackScores)
        {
            <button class="btn btn-outline-primary btn-sm me-2" @onclick="OnGenerateChampionshipClicked" disabled="@isGenerating">
                @(isGenerating ? "Generating..." : (HasChampionship ? "Regenerate Championship Round" : "Generate Championship Round"))
            </button>
            @if (HasChampionship)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="RemoveChampionship" disabled="@isRemoving">
                    @(isRemoving ? "Removing..." : "Remove Championship Round")
                </button>
            }
        }
    </div>

    @if (editMode)
    {
        <div class="alert alert-info py-2 no-print">
            Tap a player, then tap another player <strong>in the same round</strong> to swap them. Changes save automatically.
        </div>
    }

    @if (swapWarning != null)
    {
        <div class="alert alert-warning alert-dismissible py-2 no-print" role="alert">
            ⚠️ @swapWarning
            <button type="button" class="btn-close" aria-label="Close" @onclick="@(() => swapWarning = null)"></button>
        </div>
    }

    @if (showRegenerateConfirm)
    {
        <div class="modal d-block no-print" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Regenerate schedule?</h5>
                        <button type="button" class="btn-close" aria-label="Close"
                                @onclick="@(() => showRegenerateConfirm = false)"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">This will replace the current schedule with a new one. The existing rounds, matches, <strong>entered scores, and any championship round</strong> will be deleted.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary"
                                @onclick="@(() => showRegenerateConfirm = false)">Cancel</button>
                        <button type="button" class="btn btn-warning" @onclick="ConfirmRegenerate">Yes, regenerate</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showUnscoredWarning)
    {
        <div class="modal d-block no-print" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Some matches have no score</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="@(() => showUnscoredWarning = false)"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">⚠️ @unscoredCount of @totalMatchCount matches are unscored. Standings will use only the scores you've entered.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="@(() => showUnscoredWarning = false)">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="ConfirmGenerateChampionship">Generate anyway</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (trackScores && champNotEnoughPlayers)
    {
        <div class="alert alert-warning py-2 no-print" role="alert">
            Not enough players for a championship court (need at least 4). Enter more players or scores first.
        </div>
    }

    @if (evt.Rounds.Count == 0)
    {
        <div class="alert alert-info">No schedule generated yet. <a href="/event/@evt.Id/setup">Go to setup</a> to generate one.</div>
    }
    else
    {
        <div class="schedule-sheet">
            <div class="sheet-banner">
                <img src="/images/NEPC-Logo.svg" class="sheet-logo" alt="NEPC" />
                <h1 class="sheet-title">@evt.Name</h1>
            </div>
            <div class="sheet-subtitle">
                @evt.Date.ToString("MMMM d, yyyy") &middot; @evt.EventPlayers.Count players &middot; @courtNames.Count courts
            </div>
            <table class="sheet-table @(trackScores ? "show-scores" : null)">
                <thead>
                    <tr>
                        <th class="round-col">Round</th>
                        @foreach (var courtName in courtNames)
                        {
                            <th>@courtName</th>
                        }
                        @if (showByeColumn)
                        {
                            <th>Bye</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var round in evt.Rounds.OrderBy(r => r.RoundNumber))
                    {
                        <tr class="@(round.IsChampionship ? "champ-row" : null)">
                            <td class="round-num">@(round.IsChampionship ? "🏆" : round.RoundNumber.ToString())</td>
                            @for (int c = 0; c < courtNames.Count; c++)
                            {
                                var courtNum = c + 1;
                                var match = round.Matches.FirstOrDefault(m => m.CourtNumber == courtNum);
                                <td class="match-cell">
                                    @if (match != null)
                                    {
                                        <div class="team-line">
                                            <span>@PlayerSpan(round.Id, match.Team1Player1) &amp; @PlayerSpan(round.Id, match.Team1Player2)</span>
                                            @if (trackScores)
                                            {
                                                <input type="number" min="0" class="score-input"
                                                       value="@match.Team1Score"
                                                       @onchange="@(e => OnScoreChanged(match, team1: true, e.Value?.ToString()))" />
                                            }
                                        </div>
                                        <div class="vs">vs</div>
                                        <div class="team-line">
                                            <span>@PlayerSpan(round.Id, match.Team2Player1) &amp; @PlayerSpan(round.Id, match.Team2Player2)</span>
                                            @if (trackScores)
                                            {
                                                <input type="number" min="0" class="score-input"
                                                       value="@match.Team2Score"
                                                       @onchange="@(e => OnScoreChanged(match, team1: false, e.Value?.ToString()))" />
                                            }
                                        </div>
                                    }
                                </td>
                            }
                            @if (showByeColumn)
                            {
                                <td class="bye-cell">
                                    @{ var byeList = round.Byes.ToList(); }
                                    @for (int b = 0; b < byeList.Count; b++)
                                    {
                                        if (b > 0)
                                        {
                                            <span>, </span>
                                        }
                                        @PlayerSpan(round.Id, byeList[b].Player)
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            @{ var standings = StandingsCalculator.Compute(
                   evt.EventPlayers.Select(ep => ep.Player).ToList(), evt.Rounds); }
            @if (trackScores && standings.Any(r => r.PointsFor > 0 || r.PointsAgainst > 0))
            {
                <div class="no-print">
                    <h2 class="standings-title">Standings</h2>
                    <table class="sheet-table standings-table">
                        <thead>
                            <tr><th>#</th><th class="text-start">Player</th><th>W</th><th>Diff</th><th>Pts</th></tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @foreach (var row in standings)
                            {
                                <tr>
                                    <td>@rank</td>
                                    <td class="text-start">@row.Player.Name</td>
                                    <td>@row.Wins</td>
                                    <td>@(row.Diff > 0 ? $"+{row.Diff}" : row.Diff.ToString())</td>
                                    <td>@row.PointsFor</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public int EventId { get; set; }

    private Event? evt;
    private List<string> courtNames = new();
    private bool isRegenerating;
    private bool showRegenerateConfirm;

    private bool editMode;
    private (int RoundId, int PlayerId)? selected;
    private string? swapWarning;

    private bool isGenerating;
    private bool trackScores;
    private bool showByeColumn = true;
    private bool isRemoving;
    private bool showUnscoredWarning;
    private bool champNotEnoughPlayers;
    private int unscoredCount;
    private int totalMatchCount;

    private bool HasChampionship => evt?.Rounds.Any(r => r.IsChampionship) ?? false;

    protected override async Task OnInitializedAsync()
    {
        evt = await EventService.GetByIdAsync(EventId);
        if (evt != null)
        {
            courtNames = evt.GetCourtNamesList();
        }
    }

    private async Task Print()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private RenderFragment PlayerSpan(int roundId, Player p) => __builder =>
    {
        if (!editMode)
        {
            __builder.AddContent(0, p.Name);
            return;
        }

        var isSelected = selected is { } s && s.RoundId == roundId && s.PlayerId == p.Id;
        __builder.OpenElement(1, "span");
        __builder.AddAttribute(2, "class", isSelected ? "player-chip selected" : "player-chip");
        __builder.AddAttribute(3, "onclick",
            EventCallback.Factory.Create(this, () => OnPlayerTapped(roundId, p.Id)));
        __builder.AddContent(4, p.Name);
        __builder.CloseElement();
    };

    private void ToggleEditMode()
    {
        editMode = !editMode;
        selected = null;
        swapWarning = null;
    }

    private async Task OnPlayerTapped(int roundId, int playerId)
    {
        if (!editMode || evt == null) return;

        // First tap: select.
        if (selected is not { } sel)
        {
            selected = (roundId, playerId);
            return;
        }

        // Tapping the same player again: deselect.
        if (sel.RoundId == roundId && sel.PlayerId == playerId)
        {
            selected = null;
            return;
        }

        // Tapping a player in a different round: move the selection there
        // (swaps are within-round only).
        if (sel.RoundId != roundId)
        {
            selected = (roundId, playerId);
            return;
        }

        // Same round, different player: swap.
        var repeatsBefore = ScheduleStats.PartnerRepeatPairs(evt.Rounds);

        await EventService.SwapPlayersAsync(roundId, sel.PlayerId, playerId);
        selected = null;
        evt = await EventService.GetByIdAsync(EventId);

        swapWarning = evt == null ? null : DescribeNewRepeats(repeatsBefore);
    }

    private string? DescribeNewRepeats(HashSet<(int, int)> repeatsBefore)
    {
        if (evt == null) return null;

        var newRepeats = ScheduleStats.PartnerRepeatPairs(evt.Rounds);
        newRepeats.ExceptWith(repeatsBefore);
        if (newRepeats.Count == 0) return null;

        var names = evt.EventPlayers
            .Where(ep => ep.Player != null)
            .ToDictionary(ep => ep.Player!.Id, ep => ep.Player!.Name);

        var descriptions = newRepeats
            .Select(pair => $"{Name(names, pair.Item1)} & {Name(names, pair.Item2)} now partner more than once")
            .ToList();

        return string.Join("; ", descriptions) + ". (Swap kept.)";
    }

    private static string Name(Dictionary<int, string> names, int id)
        => names.TryGetValue(id, out var n) ? n : $"#{id}";

    private async Task ConfirmRegenerate()
    {
        showRegenerateConfirm = false;
        await Regenerate();
    }

    private async Task Regenerate()
    {
        if (evt == null || isRegenerating) return;

        isRegenerating = true;
        champNotEnoughPlayers = false;
        try
        {
            var players = evt.EventPlayers.Select(ep => ep.Player!).ToList();
            var rounds = evt.Rounds.Count > 0 ? evt.Rounds.Count : 1;

            // Random seed each press so greedy (deterministic) configs actually re-roll.
            var result = ScheduleGenerator.GenerateShuffled(players, evt.NumberOfCourts, rounds, Random.Shared.Next());
            await EventService.SaveScheduleAsync(evt.Id, result);

            evt = await EventService.GetByIdAsync(EventId);
            courtNames = evt?.GetCourtNamesList() ?? new();
        }
        finally
        {
            isRegenerating = false;
        }
    }

    private async Task OnScoreChanged(Match match, bool team1, string? raw)
    {
        int? value = int.TryParse(raw, out var v) && v >= 0 ? v : null;
        if (team1) match.Team1Score = value;
        else match.Team2Score = value;

        await EventService.SaveMatchScoreAsync(match.Id, match.Team1Score, match.Team2Score);
        // standings recompute on the re-render that follows this handler
    }

    private async Task OnGenerateChampionshipClicked()
    {
        if (evt == null) return;
        var regularMatches = evt.Rounds.Where(r => !r.IsChampionship).SelectMany(r => r.Matches).ToList();
        totalMatchCount = regularMatches.Count;
        unscoredCount = regularMatches.Count(m => m.Team1Score is null || m.Team2Score is null);

        if (unscoredCount > 0)
        {
            showUnscoredWarning = true;
            return;
        }
        await GenerateChampionship();
    }

    private async Task ConfirmGenerateChampionship()
    {
        showUnscoredWarning = false;
        await GenerateChampionship();
    }

    private async Task GenerateChampionship()
    {
        if (evt == null || isGenerating) return;
        isGenerating = true;
        champNotEnoughPlayers = false;
        try
        {
            var created = await EventService.GenerateChampionshipRoundAsync(evt.Id);
            champNotEnoughPlayers = created == null;
            evt = await EventService.GetByIdAsync(EventId);
            courtNames = evt?.GetCourtNamesList() ?? new();
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task RemoveChampionship()
    {
        if (evt == null || isRemoving) return;
        isRemoving = true;
        champNotEnoughPlayers = false;
        try
        {
            await EventService.RemoveChampionshipRoundAsync(evt.Id);
            evt = await EventService.GetByIdAsync(EventId);
            courtNames = evt?.GetCourtNamesList() ?? new();
        }
        finally
        {
            isRemoving = false;
        }
    }
}

<style>
    /* Names stay centered (so "vs" lines up under them); the score box is
       anchored to the right edge of its line without shifting the names. */
    .team-line { position: relative; text-align: center; }
    .score-input {
        position: absolute; right: 0; top: 50%; transform: translateY(-50%);
        width: 3rem; text-align: center;
    }
    .champ-row { background-color: #fff3cd; }
    .standings-title { font-size: 1.1rem; margin-top: 1rem; }
    .standings-table { width: auto; }
    @@media screen {
        /* When scores are shown, shift the names and "vs" left together so they
           keep clear of the right-anchored score box (and stay aligned). */
        .show-scores .team-line,
        .show-scores .vs { padding-right: 3.75rem; }
    }
    @@media print {
        /* The printed schedule is a clean handout — never print the score inputs. */
        .score-input { display: none !important; }
    }
</style>
